# Copy to api.env (mode 600) on docker.lan. Never commit real secrets.
WDMBG_PTR_ENABLED=1
# WDMBG_GEOIP_DB_PATH=/data/geoip/GeoLite2-Country.mmdb

# Optional AdGuard Home hostname resolution (rewrite → DHCP → clients, before PTR)
# WDMBG_ADGUARD_URL=http://adguard.lan
# WDMBG_ADGUARD_USER=admin
# WDMBG_ADGUARD_PASSWORD=
# WDMBG_ADGUARD_ENABLED=1
# WDMBG_ADGUARD_TIMEOUT_MS=1500
# WDMBG_ADGUARD_REFRESH_MS=300000
# WDMBG_ADGUARD_CACHE_TTL_MS=600000
