    "@wdmbg/config": "workspace:*",
    "@wdmbg/contracts": "workspace:*",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.32.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
