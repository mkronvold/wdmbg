WDMBG_API_HOST=0.0.0.0
WDMBG_API_PORT=4080
# Optional Postgres for aliases / lookup_cache / settings (Phase 5+)
# WDMBG_DATABASE_URL=******postgres:5432/wdmbg
# Set to 0 to disable on-demand PTR lookups
WDMBG_PTR_ENABLED=1
# Optional offline GeoIP MMDB path (see docs/DEPLOY-HOME.md)
# WDMBG_GEOIP_DB_PATH=/data/geoip/GeoLite2-Country.mmdb

# Optional AdGuard Home name resolution (before PTR). Off when URL unset.
# WDMBG_ADGUARD_URL=http://adguard.lan
# WDMBG_ADGUARD_USER=
# WDMBG_ADGUARD_PASSWORD=
# WDMBG_ADGUARD_ENABLED=1
