{
  "name": "wdmbg",
  "version": "0.0.0",
  "private": true,
  "description": "Where did my bandwidth go? — lightweight passive traffic monitor",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @wdmbg/e2e run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm format:check"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "turbo": "^2.11.3",
    "typescript": "^5.9.2"
  }
}
